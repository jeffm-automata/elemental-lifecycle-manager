# Tooling the recipe builds with when --elemental-image is not given. Names only, no secrets.
# This is a lab merge, not released tooling: every difference is listed in deviations.json.
ELEMENTAL_REPO=https://github.com/jeffm-automata/elemental.git
ELEMENTAL_REF=agent/T1.4-lab
DEVIATIONS_FILE=deviations.json
# Where release tags come from when ELEMENTAL_REPO is a fork without them (empty: do not fetch).
ELEMENTAL_TAGS_REPO=https://github.com/SUSE/elemental.git
